{
  "entities": {
    "Venue": {
      "title": "Venue",
      "description": "Bar, club o sala de música en vivo del catálogo compartido de DeGira.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "address": { "type": "string", "minLength": 1, "maxLength": 200 },
        "neighborhood": { "type": "string", "minLength": 1, "maxLength": 80 },
        "coverPhoto": { "type": "string", "maxLength": 600 },
        "photos": { "type": "array", "description": "URLs de fotos de la sala (máx 10)" },
        "bio": { "type": "string", "maxLength": 1200 },
        "capacity": { "type": "number" },
        "backline": { "type": "array", "description": "Listado de backline disponible" },
        "acousticCharacteristics": { "type": "string", "maxLength": 500 },
        "hospitality": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "ratingBreakdown": { "type": "object" },
        "venueCbuAlias": { "type": "string", "maxLength": 120 },
        "ownerBarId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "defaultRiderTemplate": { "type": "object" },
        "visibility": { "type": "string", "enum": ["public"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAtTimestamp": { "type": "string", "format": "date-time" },
        "updatedAtTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "type",
        "address",
        "neighborhood",
        "capacity",
        "visibility",
        "ownerUid",
        "createdAtTimestamp",
        "updatedAtTimestamp"
      ]
    },
    "EventProposal": {
      "title": "EventProposal",
      "description": "Propuesta de fecha/show creada por un bar con slots horarios, caché, capacidad y rider.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "venueAddress": { "type": "string", "maxLength": 200 },
        "venueNeighborhood": { "type": "string", "minLength": 1, "maxLength": 80 },
        "venuePhoto": { "type": "string", "maxLength": 600 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "date": { "type": "string", "minLength": 8, "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "endTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "totalCapacity": { "type": "number" },
        "remainingCapacity": { "type": "number" },
        "baseCachetARS": { "type": "number" },
        "cachetType": { "type": "string", "enum": ["fijo", "a_la_gorra"] },
        "ticketPriceARS": { "type": "number" },
        "cancelDaysBefore": { "type": "number" },
        "targetGenres": { "type": "array" },
        "slots": { "type": "array" },
        "rider": { "type": "object" },
        "status": { "type": "string", "enum": ["propuesta", "cancelada", "para_publicar", "publicada", "agotada", "archivado"] },
        "eventCode": { "type": "string", "minLength": 3, "maxLength": 40 },
        "waitlist": { "type": "array" },
        "cachetPaid": { "type": "boolean" },
        "cachetPaidAt": { "type": "string", "maxLength": 60 },
        "feedbackSentAt": { "type": "string", "maxLength": 60 },
        "cancelledAt": { "type": "string", "maxLength": 60 },
        "lastActionAt": { "type": "string", "maxLength": 60 },
        "lastActionSummary": { "type": "string", "maxLength": 240 },
        "lastActionActor": { "type": "string", "maxLength": 140 },
        "visibility": { "type": "string", "enum": ["public"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "createdAtTimestamp": { "type": "string", "format": "date-time" },
        "updatedAtTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "venueId",
        "venueName",
        "venueNeighborhood",
        "title",
        "date",
        "startTime",
        "endTime",
        "totalCapacity",
        "remainingCapacity",
        "baseCachetARS",
        "slots",
        "rider",
        "status",
        "eventCode",
        "visibility",
        "ownerUid",
        "createdAt",
        "createdAtTimestamp",
        "updatedAtTimestamp"
      ]
    },
    "SlotBid": {
      "title": "SlotBid",
      "description": "Postulación/negociación de un músico o banda para un horario específico de un evento.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slotId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "musicianId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "musicianName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "musicianAvatar": { "type": "string", "maxLength": 600 },
        "proposedCachetARS": { "type": "number" },
        "cachetType": { "type": "string", "enum": ["fijo", "a_la_gorra"] },
        "musiciansCount": { "type": "number" },
        "equipmentProvided": { "type": "string", "maxLength": 400 },
        "equipmentNeeded": { "type": "string", "maxLength": 400 },
        "musicLinks": { "type": "object" },
        "inputList": { "type": "array" },
        "reminderSentAt": { "type": "string", "maxLength": 60 },
        "reminderCount": { "type": "number" },
        "retracted": { "type": "boolean" },
        "retractedAt": { "type": "string", "maxLength": 60 },
        "cancelDaysBefore": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente_bar", "contraoferta_bar", "contraoferta_musico", "aceptada", "rechazada"] },
        "history": { "type": "array" },
        "visibility": { "type": "string", "enum": ["public"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "createdAtTimestamp": { "type": "string", "format": "date-time" },
        "updatedAtTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "eventId",
        "slotId",
        "musicianId",
        "musicianName",
        "proposedCachetARS",
        "musiciansCount",
        "equipmentProvided",
        "equipmentNeeded",
        "status",
        "history",
        "visibility",
        "ownerUid",
        "createdAt",
        "createdAtTimestamp",
        "updatedAtTimestamp"
      ]
    },
    "PublicEventReservation": {
      "title": "PublicEventReservation",
      "description": "Reserva de entrada del público (sin PII personal expuesta públicamente).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "eventCode": { "type": "string", "minLength": 3, "maxLength": 40 },
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "venueOwnerUid": { "type": "string", "maxLength": 128 },
        "venueName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "venueAddress": { "type": "string", "maxLength": 200 },
        "venueNeighborhood": { "type": "string", "maxLength": 80 },
        "eventDate": { "type": "string", "maxLength": 20 },
        "eventStartTime": { "type": "string", "maxLength": 10 },
        "eventEndTime": { "type": "string", "maxLength": 10 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "partySize": { "type": "number" },
        "totalARS": { "type": "number" },
        "expiresAt": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente_pago", "comprobante_subido", "confirmada", "expirada", "cancelada"] },
        "receiptImage": { "type": "string", "maxLength": 450000 },
        "receiptUploadTime": { "type": "string", "maxLength": 60 },
        "receiptOcrNotes": { "type": "string", "maxLength": 500 },
        "qrTicketCode": { "type": "string", "maxLength": 160 },
        "qrEmailSent": { "type": "boolean" },
        "checkInStatus": { "type": "string", "enum": ["pending", "checked_in"] },
        "checkedInAt": { "type": "string", "maxLength": 60 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "createdAtTimestamp": { "type": "string", "format": "date-time" },
        "updatedAtTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "eventId",
        "eventTitle",
        "eventCode",
        "venueId",
        "venueName",
        "userId",
        "userName",
        "partySize",
        "totalARS",
        "expiresAt",
        "status",
        "ownerUid",
        "createdAt",
        "createdAtTimestamp",
        "updatedAtTimestamp"
      ]
    },
    "EventReview360": {
      "title": "EventReview360",
      "description": "Calificación 360 post-evento (disponible estrictamente 2hs luego de finalizar).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fromRole": { "type": "string", "enum": ["bar", "musico", "espectador"] },
        "fromUserId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromUserName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "toType": { "type": "string", "enum": ["event", "venue", "musician"] },
        "toId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "rating": { "type": "number" },
        "categoryRatings": { "type": "object" },
        "comment": { "type": "string", "maxLength": 1000 },
        "visibility": { "type": "string", "enum": ["public"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "createdAtTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "eventId",
        "eventTitle",
        "fromRole",
        "fromUserId",
        "fromUserName",
        "toType",
        "toId",
        "toName",
        "rating",
        "categoryRatings",
        "comment",
        "visibility",
        "ownerUid",
        "createdAt",
        "createdAtTimestamp"
      ]
    }
  },
  "firestore": {
    "/venues/{venueId}": {
      "schema": { "$ref": "#/entities/Venue" },
      "description": "Catálogo compartido de bares y salas."
    },
    "/eventProposals/{eventId}": {
      "schema": { "$ref": "#/entities/EventProposal" },
      "description": "Propuestas de eventos y convocatorias por horarios."
    },
    "/slotBids/{bidId}": {
      "schema": { "$ref": "#/entities/SlotBid" },
      "description": "Postulaciones y negociaciones de músicos por horario."
    },
    "/publicEventReservations/{resId}": {
      "schema": { "$ref": "#/entities/PublicEventReservation" },
      "description": "Reservas y comprobantes de espectadores."
    },
    "/reviews360/{reviewId}": {
      "schema": { "$ref": "#/entities/EventReview360" },
      "description": "Reseñas 360 verificadas post-show."
    }
  }
}
